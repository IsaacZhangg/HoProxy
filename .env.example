# HoProxy binds to loopback by default.
HOST=127.0.0.1
PORT=3001

# Required before setting HOST to a non-loopback address.
# HOPROXY_API_KEY=replace-with-a-long-random-secret
# HOPROXY_CORS_ORIGINS=https://trusted-client.example

# Current HopGPT sessions normally require both cookies.
HOPGPT_COOKIE_CONNECT_SID=
HOPGPT_COOKIE_OPENID_USER_ID=

# Optional browser/session context.
HOPGPT_BEARER_TOKEN=
HOPGPT_COOKIE_REFRESH_TOKEN=
HOPGPT_COOKIE_CF_CLEARANCE=
HOPGPT_COOKIE_CF_BM=
HOPGPT_COOKIE_TOKEN_PROVIDER=openid
HOPGPT_USER_AGENT=

# Resource and upstream deadline defaults.
HOPROXY_BODY_LIMIT=10mb
HOPROXY_MAX_CONCURRENT_MESSAGES=8
HOPROXY_RATE_LIMIT_REQUESTS=120
HOPROXY_RATE_LIMIT_WINDOW_MS=60000
HOPROXY_UPSTREAM_CONNECT_TIMEOUT_MS=30000
HOPROXY_UPSTREAM_IDLE_TIMEOUT_MS=120000
HOPROXY_UPSTREAM_TOTAL_TIMEOUT_MS=900000
HOPGPT_TOOL_BATCH_IDLE_CLOSE_MS=500

# HOPGPT_DEBUG=true
# HOPROXY_READY_UPSTREAM_CHECK=true
